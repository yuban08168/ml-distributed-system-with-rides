# 使用Python轻量级镜像
FROM python:3.9-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    REDIS_HOST=redis \
    REDIS_PORT=6379

# 安装系统依赖
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libgomp1 \
        curl \
        net-tools \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件并安装Python包
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制项目代码
COPY . .

# 创建非root用户
RUN useradd -m -u 1000 worker \
    && chown -R worker:worker /app

# 切换用户
USER worker

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import redis; r = redis.Redis(host='localhost', port=6379, socket_timeout=1); r.ping()" || exit 1

# 默认命令
CMD ["python", "run.py", "all", "--tasks", "100", "--workers", "2"]
